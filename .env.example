# Shared local development configuration
API_PORT=4000
AGENT_PORT=4001
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
AGENT_BASE_URL=http://localhost:4001
INTERNAL_SERVICE_TOKEN=local-demo-token

# The repository runs without a model key in deterministic demo mode.
AGENT_MODE=mock

# Optional OpenAI-compatible AI Gateway configuration used by Pi mode.
# Selects the whole model profile: prompt, context, inference and fallback settings.
AGENT_MODEL_PROFILE=openai-compatible-bi-v1
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Optional fallback profile. It is used only for model timeout/provider failures.
DEEPSEEK_GATEWAY_BASE_URL=
DEEPSEEK_GATEWAY_API_KEY=
DEEPSEEK_GATEWAY_MODEL=
